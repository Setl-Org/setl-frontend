# API base URL (defaults to /api if not set)
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_EXTERNAL_API_BASE_URL=http://localhost:3000/api/external/v1
VITE_PDF_SERVICE_BASE_URL=http://localhost:5000

# Optional: SSO redirect URLs (leave empty to hide or disable SSO buttons)
# VITE_AUTH_GOOGLE_URL=
# VITE_AUTH_MICROSOFT_URL=

# --- Contact form (api/contact.js) ---
# Server-side only. Set these in Vercel: Settings → Environment Variables.
# Do NOT commit real values; copy this file to .env.local for local development.

# Inbox that receives landing-page "Talk to the team" inquiries.
CONTACT_TO_EMAIL=

# Resend API key (https://resend.com) used to send the emails.
RESEND_API_KEY=

# Optional verified sender. Defaults to Resend's sandbox (onboarding@resend.dev)
# if left blank. Use a verified domain to send to any recipient.
CONTACT_FROM_EMAIL=
